{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile in the application",
      "type": "object",
      "properties": {
        "roadmap": {
          "type": "object",
          "description": "The user's career roadmap generated by the AI"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of the last update"
        }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "User"
      },
      "description": "User profiles and their roadmaps"
    }
  }
}
